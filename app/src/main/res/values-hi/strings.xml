    <string name="app_name">Kodak 32HDX7XPRO Remote</string>
    <string name="app_description">अनौपचारिक रिमोट ऐप — Kodak 32HDX7XPRO Android TV के लिए। Kodak से संबद्ध या अनुमोदित नहीं।</string>
    <string name="unofficial">अनौपचारिक रिमोट ऐप</string>
    <string name="onb1_title">अनौपचारिक टीवी रिमोट</string>
    <string name="onb1_body">अपने फ़ोन से Kodak 32HDX7XPRO को कंट्रोल करें। यह ऐप Kodak ने नहीं बनाया है और न ही उससे जुड़ा है।</string>
    <string name="onb2_title">सिर्फ़ लोकल Wi‑Fi</string>
    <string name="onb2_body">फ़ोन और टीवी एक ही Wi‑Fi नेटवर्क पर होने चाहिए। कमांड सीधे टीवी को जाते हैं, किसी क्लाउड सर्वर से नहीं।</string>
    <string name="onb3_title">पहले संगतता जांचें</string>
    <string name="onb3_body">हर टीवी मॉडल Wi‑Fi कंट्रोल सपोर्ट नहीं करता। हम पहले आपके टीवी को जांचेंगे। न करे तो IR ब्लास्टर वाले फ़ोन से IR रिमोट इस्तेमाल करें।</string>
